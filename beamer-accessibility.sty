\NeedsTeXFormat{LaTeX2e}[2025-06-01]
\ProvidesPackage{beamer-accessibility}[2026/09/01 v1.0 Accessible Beamer presentations with semantic PDF tagging]

% PDF management must have been selected before the class. The companion
% wrapper does this, or a package-only user can place
% \RequirePackage{pdfmanagement} before \documentclass{beamer}.
\RequirePackage{tagpdf}

\ExplSyntaxOn
\tl_new:N \g__ba_lang_tl
\tl_gset:Nn \g__ba_lang_tl { en-US }
\bool_new:N \g__ba_strict_bool
\bool_gset_false:N \g__ba_strict_bool
\bool_new:N \g__ba_navsymbols_bool
\bool_gset_false:N \g__ba_navsymbols_bool
\bool_new:N \g__ba_colors_bool
\bool_gset_false:N \g__ba_colors_bool
\tl_new:N \g__ba_overlay_policy_tl
\tl_gset:Nn \g__ba_overlay_policy_tl { pages }

\keys_define:nn { beamer-accessibility }
  {
    lang .tl_gset:N = \g__ba_lang_tl,
    lang .initial:n = { en-US },
    mode .choice:,
    mode / strict .code:n = { \bool_gset_true:N \g__ba_strict_bool },
    mode / compat .code:n = { \bool_gset_false:N \g__ba_strict_bool },
    strict .code:n = { \bool_gset_true:N \g__ba_strict_bool },
    compat .code:n = { \bool_gset_false:N \g__ba_strict_bool },
    navsymbols .bool_gset:N = \g__ba_navsymbols_bool,
    navsymbols .initial:n = { false },
    accessible-colors .bool_gset:N = \g__ba_colors_bool,
    accessible-colors .initial:n = { false },
    overlay-policy .choice:,
    overlay-policy / pages .code:n = { \tl_gset:Nn \g__ba_overlay_policy_tl { pages } },
    overlay-policy / handout .code:n = { \tl_gset:Nn \g__ba_overlay_policy_tl { handout } },
    overlay-policy / strict .code:n = { \tl_gset:Nn \g__ba_overlay_policy_tl { strict } },
    overlay-policy .initial:n = { pages },
    unknown .code:n = {},
  }

\ProcessKeyOptions [ beamer-accessibility ]

% Compatibility boundary for Beamer's installed overlay item and pause parsers.
\makeatletter
\@ifundefined{beamer@parseitem}
  {\PackageError{beamer-accessibility}{Unsupported Beamer overlay parser}{Update Beamer or use overlay-policy=pages.}}
  {\let\ba@orig@parseitem\beamer@parseitem
   \def\beamer@parseitem<#1>{%
     \tl_if_eq:NnT \g__ba_overlay_policy_tl { strict }
       {\PackageError{beamer-accessibility}{Overlay~specification~on~\protect\item\space~detected~in~strict~mode}{Use overlay-policy=pages or overlay-policy=handout.}}%
     \ba@orig@parseitem<#1>}}

\@ifundefined{beamer@@pause}
  {\PackageError{beamer-accessibility}{Unsupported Beamer pause mechanism}{Update Beamer or use overlay-policy=pages.}}
  {\let\ba@orig@beamer@@pause\beamer@@pause
   \NewDocumentCommand{\ba@pause}{ O{} }
     {
       \tl_if_eq:NnT \g__ba_overlay_policy_tl { strict }
         {\PackageError{beamer-accessibility}{\protect\pause\space detected in strict mode}{Use overlay-policy=pages or overlay-policy=handout.}}%
       \bool_if:NTF \g__ba_para_open_bool
         {
           \tag_mc_end:
           \ba@orig@beamer@@pause[#1]%
           \tag_mc_begin:n { }
         }
         {
           \ba@orig@beamer@@pause[#1]%
         }
     }
   \let\beamer@@pause\ba@pause}
\makeatother

\AddToHook{begindocument/before}
  {
    \tl_if_eq:NnT \g__ba_overlay_policy_tl { handout }
      {
        \cs_if_exist:cTF { beamer@currentmode }
          {
            \str_if_eq:eeF { \use:c { beamer@currentmode } } { handout }
              {
                \PackageError{beamer-accessibility}
                  {overlay-policy=handout~requires~Beamer~handout~mode}
                  {Pass~'handout'~to~\protect\documentclass\space~or~use~\protect\documentclass[overlay-policy=handout]{beamer-accessibility}.}
              }
          }
          {
            \PackageError{beamer-accessibility}
              {overlay-policy=handout~requires~Beamer~handout~mode}
              {Pass~'handout'~to~\protect\documentclass\space~or~use~\protect\documentclass[overlay-policy=handout]{beamer-accessibility}.}
          }
      }
    \hypersetup{bookmarks=true}
    \pdfmanagement_add:nnn { Catalog } { Lang } { (\g__ba_lang_tl) }
    \pdfmanagement_add:nnn { Catalog } { ViewerPreferences } { << /DisplayDocTitle ~ true >> }
    \tl_set:Nn \l__tag_name_link_tl { Link }
    \bool_gset_true:N \l__tag_active_socket_bool
    \bool_if:NF \g__ba_navsymbols_bool
      {
        \setbeamertemplate{navigation~symbols}{}
      }
    \bool_if:NT \g__ba_colors_bool
      {
        \setbeamercolor{block title alerted}{fg=white,bg=red!75!black}
        \setbeamercolor{block body alerted}{fg=black,bg=red!10!white}
        \setbeamercolor{author in head/foot}{fg=white,bg=blue!40!black}
        \setbeamercolor{title in head/foot}{fg=white,bg=blue!30!black}
        \setbeamercolor{date in head/foot}{fg=white,bg=blue!20!black}
        \setbeamercolor{alerted text}{fg=red!60!black}
      }
    \typeout{=============================================================}
    \typeout{beamer-accessibility:~Version~1.0~(2026/09/01)}
    \typeout{beamer-accessibility:~overlay-policy=\g__ba_overlay_policy_tl}
    \typeout{beamer-accessibility:~accessible-colors=\bool_if:NTF \g__ba_colors_bool {enabled}{disabled}}
    \typeout{beamer-accessibility:~navigation~symbols=\bool_if:NTF \g__ba_navsymbols_bool {tagged}{hidden}}
    \typeout{=============================================================}
  }

\tagpdfsetup
  {
    activate,
    activate/socket = true,
    activate/mc     = true,
    activate/tree   = true,
    activate/struct = true,
    role/new-tag    = frame/Sect,
    role/new-tag    = frametitle/H1,
    role/new-tag    = block/Div,
    role/new-tag    = blocktitle/H2,
    role/new-tag    = column/Div,
    role/new-tag    = Link/Link,
    role/new-tag    = Table/Table,
    role/new-tag    = TR/TR,
    role/new-tag    = TH/TH,
    role/new-tag    = TD/TD,
  }

% Define tagging socket plugs for links: only create structure inside active slide body
\NewTaggingSocketPlug{link/before}{ba_link}
  {
    \bool_if:NTF \g__ba_body_active_bool
      {
        \mode_leave_vertical:
        \tag_mc_end_push:
        \tag_struct_begin:n { tag = \UseStructureName{link} }
        \tag_mc_begin:n {}
        #1
      }
      {
        \pdfannot_dict_put:nne { link/GoTo } { Contents } { (Navigation) }
        \pdfannot_dict_put:nne { link/Named } { Contents } { (Navigation) }
        #1
      }
  }
\AssignTaggingSocketPlug{link/before}{ba_link}

\NewTaggingSocketPlug{link/after}{ba_link}
  {
    \bool_if:NTF \g__ba_body_active_bool
      {
        \tag_struct_insert_annot:ee
          { \pdfannot_link_ref_last: }
          { \tag_struct_parent_int: }
        \tag_mc_end:
        \tag_struct_end:
        \tag_mc_begin_pop:n {}
      }
      {
      }
  }
\AssignTaggingSocketPlug{link/after}{ba_link}

\cs_new_protected:Npn \ba_artifact_begin:n #1
  {
    \tag_mc_begin:n { artifact = #1 }
  }

\cs_new_protected:Npn \ba_artifact_end:
  {
    \tag_mc_end:
  }

\cs_new_protected:Npn \ba_set_link_contents:nn #1#2
  {
    \pdfannot_dict_put:nne { #1 } { Contents } { (#2) }
  }

\cs_new_protected:Npn \ba_nav_symbols_begin:
  {
    \ba_artifact_begin:n { layout }
    \pdfannot_dict_put:nne { link/GoTo } { Contents } { (Navigation) }
    \pdfannot_dict_put:nne { link/Named } { Contents } { (Navigation) }
  }

% Structural states
\bool_new:N \g__ba_frame_active_bool
\bool_new:N \g__ba_body_active_bool
\bool_new:N \g__ba_para_open_bool
\bool_new:N \g__ba_para_artifact_bool
\bool_new:N \g__ba_in_title_bool
\bool_new:N \g__ba_in_label_bool
\bool_new:N \g__ba_in_table_bool
\int_new:N  \g__ba_para_suppress_int
\int_new:N  \g__ba_list_depth_int

% Per-depth list state for nesting levels 1, 2, and 3:
\bool_new:N \g__ba_list_open_i_bool
\bool_new:N \g__ba_li_open_i_bool
\bool_new:N \g__ba_lbody_open_i_bool

\bool_new:N \g__ba_list_open_ii_bool
\bool_new:N \g__ba_li_open_ii_bool
\bool_new:N \g__ba_lbody_open_ii_bool

\bool_new:N \g__ba_list_open_iii_bool
\bool_new:N \g__ba_li_open_iii_bool
\bool_new:N \g__ba_lbody_open_iii_bool

% Block structure state:
\bool_new:N \g__ba_block_open_bool
\bool_new:N \g__ba_in_block_title_bool
\bool_new:N \g__ba_block_title_open_bool

% Column structure state:
\bool_new:N \g__ba_column_open_bool

% Graphics structure state:
\bool_new:N \g__ba_graphics_struct_bool
\bool_new:N \g__ba_graphics_decorative_bool
\bool_new:N \g__ba_in_figure_bool
\tl_new:N   \g__ba_graphics_alt_tl

% Table structure state:
\bool_new:N \g__ba_table_open_bool
\bool_new:N \g__ba_tr_open_bool
\bool_new:N \g__ba_in_accessibletable_bool

% Logical frame and bookmark state:
\int_new:N  \g__ba_logical_frame_int
\bool_new:N \g__ba_frame_bookmarked_bool

\cs_new_protected:Npn \ba_body_begin:
  {
    \bool_gset_true:N \g__ba_body_active_bool
    \bool_if:NF \g__ba_frame_bookmarked_bool
      {
        \pdfbookmark[1]{Slide ~ \int_use:N \g__ba_logical_frame_int}{ba@frame@\int_use:N \g__ba_logical_frame_int}
        \bool_gset_true:N \g__ba_frame_bookmarked_bool
      }
  }

\cs_new_protected:Npn \ba_body_end:
  {
    \ba_paragraph_end:
    \bool_gset_false:N \g__ba_body_active_bool
  }

\cs_new_protected:Npn \ba_paragraph_begin:
  {
    \ba_paragraph_end:
    \bool_if:NT \g__ba_frame_active_bool
      {
        \bool_if:NT \g__ba_body_active_bool
          {
            \bool_if:NF \g__ba_in_title_bool
              {
                \bool_if:NF \g__ba_in_label_bool
                  {
                    \bool_if:NF \g__ba_in_table_bool
                      {
                        \bool_if:NF \g__ba_in_figure_bool
                          {
                        \bool_set_true:N \l_tmpb_bool
                        \int_compare:nNnT { \g__ba_list_depth_int } > { 0 }
                          {
                            \legacy_if:nT { @inlabel }
                              { \bool_set_false:N \l_tmpb_bool }
                          }
                        \bool_if:NT \l_tmpb_bool
                          {
                            \int_compare:nNnTF { \use:c { beamer@coveringdepth } } = { 0 }
                              {
                                \int_compare:nNnT { \g__ba_para_suppress_int } = { 0 }
                                  {
                                    \bool_if:NTF \g__ba_in_block_title_bool
                                      {
                                        \bool_if:NF \g__ba_block_title_open_bool
                                          {
                                            \tag_struct_begin:n { tag = blocktitle }
                                            \tag_mc_begin:n { }
                                            \bool_gset_true:N \g__ba_block_title_open_bool
                                          }
                                      }
                                      {
                                        \int_compare:nNnTF { \g__ba_list_depth_int } > { 0 }
                                          {
                                            \use:c { bool_if:cT } { g__ba_lbody_open_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
                                              {
                                                \bool_if:NF \g__ba_para_open_bool
                                                  {
                                                    \tag_struct_begin:n { tag = P }
                                                    \tag_mc_begin:n { }
                                                    \bool_gset_true:N \g__ba_para_open_bool
                                                  }
                                              }
                                          }
                                          {
                                            \bool_if:NF \g__ba_para_open_bool
                                              {
                                                \tag_struct_begin:n { tag = P }
                                                \tag_mc_begin:n { }
                                                \bool_gset_true:N \g__ba_para_open_bool
                                              }
                                          }
                                      }
                                  }
                              }
                              {
                                % When covered, artifact any emitted text so it is not unclassified
                                \ba_artifact_begin:n { layout }
                                \bool_gset_true:N \g__ba_para_artifact_bool
                              }
                          }
                          }
                      }
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \ba_paragraph_end:
  {
    \bool_if:NT \g__ba_para_artifact_bool
      {
        \ba_artifact_end:
        \bool_gset_false:N \g__ba_para_artifact_bool
      }
    \bool_if:NT \g__ba_block_title_open_bool
      {
        \tag_mc_end:
        \tag_struct_end:
        \bool_gset_false:N \g__ba_block_title_open_bool
      }
    \bool_if:NT \g__ba_para_open_bool
      {
        \tag_mc_end:
        \tag_struct_end:
        \bool_gset_false:N \g__ba_para_open_bool
      }
  }

\cs_new_protected:Npn \ba_block_begin:
  {
    \ba_paragraph_end:
    \bool_if:NT \g__ba_frame_active_bool
      {
        \tag_struct_begin:n { tag = block }
        \bool_gset_true:N \g__ba_block_open_bool
        \bool_gset_true:N \g__ba_in_block_title_bool
      }
  }

\cs_new_protected:Npn \ba_block_body_begin:
  {
    \ba_paragraph_end:
    \bool_gset_false:N \g__ba_in_block_title_bool
  }

\cs_new_protected:Npn \ba_block_end:
  {
    \ba_paragraph_end:
    \int_compare:nNnT { \g__ba_list_depth_int } > { 0 }
      {
        \ba_list_close_all:
      }
    \bool_if:NT \g__ba_block_open_bool
      {
        \tag_struct_end:
        \bool_gset_false:N \g__ba_block_open_bool
      }
    \bool_gset_false:N \g__ba_in_block_title_bool
  }

\cs_new_protected:Npn \ba_graphics_set_alt:n #1
  {
    \tl_gset:Nn \g__ba_graphics_alt_tl { #1 }
    \bool_gset_false:N \g__ba_graphics_decorative_bool
  }

\cs_new_protected:Npn \ba_graphics_set_decorative:
  {
    \bool_gset_true:N \g__ba_graphics_decorative_bool
    \tl_gclear:N \g__ba_graphics_alt_tl
  }

\cs_new_protected:Npn \ba_graphics_clear:
  {
    \tl_gclear:N \g__ba_graphics_alt_tl
    \bool_gset_false:N \g__ba_graphics_decorative_bool
  }

\cs_new_protected:Npn \ba_graphics_check_alt:n #1
  {
    \bool_if:NF \g__ba_graphics_decorative_bool
      {
        \tl_if_empty:NT \g__ba_graphics_alt_tl
          {
            \bool_if:NTF \g__ba_strict_bool
              {
                \PackageError{beamer-accessibility}
                  {Non-decorative~image~'#1'~missing~required~alternative~text}
                  {Provide~alt={...}~in~\protect\includegraphics\space~or~mark~decorative=true.}
              }
              {
                \PackageWarning{beamer-accessibility}
                  {Non-decorative~image~'#1'~missing~alternative~text.~Tagging~as~Figure~without~alt.}
              }
          }
      }
  }

\cs_new_protected:Npn \ba_graphics_begin:n #1
  {
    \int_compare:nNnT { \g__ba_para_suppress_int } > { 0 }
      { \ba_suppress_end: }
    \ba_graphics_check_alt:n { #1 }
    \bool_if:NT \g__ba_frame_active_bool
      {
        \bool_if:NT \g__ba_body_active_bool
          {
            \bool_if:NTF \g__ba_graphics_decorative_bool
              {
                \tag_mc_begin:n { artifact = layout }
              }
              {
                \bool_if:NT \g__ba_para_open_bool
                  {
                    \tag_mc_end:
                  }
                \tl_if_empty:NTF \g__ba_graphics_alt_tl
                  {
                    \tag_struct_begin:n { tag = Figure }
                  }
                  {
                    \tag_struct_begin:n { tag = Figure, alt = {\g__ba_graphics_alt_tl} }
                  }
                \tag_mc_begin:n { }
                \bool_gset_true:N \g__ba_graphics_struct_bool
              }
          }
      }
  }

\cs_new_protected:Npn \ba_graphics_end:
  {
    \bool_if:NTF \g__ba_graphics_decorative_bool
      {
        \tag_mc_end:
      }
      {
        \bool_if:NT \g__ba_graphics_struct_bool
          {
            \tag_mc_end:
            \tag_struct_end:
            \bool_gset_false:N \g__ba_graphics_struct_bool
            \bool_if:NT \g__ba_para_open_bool
              {
                \tag_mc_begin:n { }
              }
          }
      }
    \ba_graphics_clear:
  }

\NewDocumentEnvironment{accessiblefigure}{ O{} m }
  {
    \ba_paragraph_end:
    \tag_struct_begin:n { tag = Figure, alt = {#2} }
    \tag_mc_begin:n { }
  }
  {
    \tag_mc_end:
    \tag_struct_end:
  }

% Option-only spelling for inline TikZ/PGFPlots (including \input sources).
\keys_define:nn { beamer-accessibility / figure }
  { alt .tl_set:N = \l__ba_fig_alt_tl,
    decorative .bool_set:N = \l__ba_fig_decorative_bool,
    artifact .bool_set:N = \l__ba_fig_decorative_bool }
\tl_if_exist:NF \l__ba_fig_alt_tl { \tl_new:N \l__ba_fig_alt_tl }
\bool_if_exist:NF \l__ba_fig_decorative_bool { \bool_new:N \l__ba_fig_decorative_bool }
\NewDocumentEnvironment{accessibleFigure}{ O{} }
  {\csname ba_paragraph_end:\endcsname
   \bool_gset_true:N \g__ba_in_figure_bool
   \group_begin:\tl_clear:N \l__ba_fig_alt_tl\bool_set_false:N \l__ba_fig_decorative_bool
   \keys_set:nn { beamer-accessibility / figure } {#1}
   \bool_if:NTF \l__ba_fig_decorative_bool
     {\tag_mc_begin:n {artifact=layout}}
     {\tl_if_empty:NTF \l__ba_fig_alt_tl
        {\ba_graphics_check_alt:n {figure}\tag_struct_begin:n {tag=Figure}\tag_mc_begin:n {}}
        {\tag_struct_begin:n {tag=Figure,alt={\l__ba_fig_alt_tl}}\tag_mc_begin:n {}}}}
  {\tag_mc_end:\bool_if:NF \l__ba_fig_decorative_bool {\tag_struct_end:}\group_end:\bool_gset_false:N \g__ba_in_figure_bool}
\RenewDocumentEnvironment{accessiblefigure}{ O{} }
  { \begin{accessibleFigure}[#1] }
  { \end{accessibleFigure} }

\keys_define:nn { beamer-accessibility / table }
