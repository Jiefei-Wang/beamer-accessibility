\tl_new:N \g__ba_table_title_tl
\bool_new:N \g__ba_table_dec_bool

\NewDocumentEnvironment{accessibleTable}{ O{} }
  {
    \ba_paragraph_end:
    \keys_set:nn { beamer-accessibility / table } { #1 }
    \tl_gset_eq:NN \g__ba_table_title_tl \l__ba_tbl_title_tl
    \bool_gset_eq:NN \g__ba_table_dec_bool \l__ba_tbl_dec_bool
    \bool_gset_true:N \g__ba_in_accessibletable_bool
    \begin{table}
    \bool_if:NT \g__ba_table_dec_bool
      {
        \ba_artifact_begin:n { layout }
        \bool_gset_true:N \g__ba_in_table_bool
      }
  }
  {
    \bool_if:NTF \g__ba_table_dec_bool
      {
        \ba_artifact_end:
        \bool_gset_false:N \g__ba_in_table_bool
      }
      {
        \bool_if:NT \g__ba_table_open_bool
          { \ba_table_end: }
      }
    \end{table}
    \bool_gset_false:N \g__ba_in_accessibletable_bool
    \tl_gclear:N \g__ba_table_title_tl
    \bool_gset_false:N \g__ba_table_dec_bool
  }

\NewDocumentEnvironment{accessibletable}{ O{} }
  { \begin{accessibleTable}[#1] }
  { \end{accessibleTable} }

