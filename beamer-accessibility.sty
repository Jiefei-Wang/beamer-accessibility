        \tag_struct_end:
        \bool_gset_false:N \g__ba_table_open_bool
      }
    \bool_gset_false:N \g__ba_in_table_bool
  }

\cs_new_protected:Npn \ba_tr_begin:
  {
    \bool_if:NF \g__ba_tr_open_bool
      {
        \tag_struct_begin:n { tag = TR }
        \bool_gset_true:N \g__ba_tr_open_bool
