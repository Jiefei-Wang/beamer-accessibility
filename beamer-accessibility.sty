\NeedsTeXFormat{LaTeX2e}[2025-06-01]
\ProvidesPackage{beamer-accessibility}[2026/08/31 v0.6 Low-level semantic tagging for Beamer]

% PDF management must have been selected before the class. The companion
% wrapper does this, or a package-only user can place
% \RequirePackage{pdfmanagement} before \documentclass{beamer}.
\RequirePackage{tagpdf}

\ExplSyntaxOn
\tagpdfsetup
  {
    activate-all,
    role/new-tag = frame/Sect,
    role/new-tag = frametitle/H1,
    role/new-tag = block/Div,
    role/new-tag = blocktitle/H2
  }

% The package wraps Beamer's existing visual implementation. It emits only
% structure and marked-content objects; Beamer remains responsible for layout.
\bool_new:N \g__ba_frame_active_bool
\bool_new:N \g__ba_body_active_bool
\bool_new:N \g__ba_para_open_bool
\bool_new:N \g__ba_in_title_bool
\bool_new:N \g__ba_in_label_bool
\bool_new:N \g__ba_frame_unsupported_bool
\int_new:N  \g__ba_para_suppress_int
\int_new:N  \g__ba_list_depth_int

% Per-depth list state for nesting levels 1, 2, and 3:
\bool_new:N \g__ba_list_pending_i_bool
\bool_new:N \g__ba_list_open_i_bool
\bool_new:N \g__ba_li_open_i_bool
\bool_new:N \g__ba_lbody_open_i_bool

\bool_new:N \g__ba_list_pending_ii_bool
\bool_new:N \g__ba_list_open_ii_bool
\bool_new:N \g__ba_li_open_ii_bool
\bool_new:N \g__ba_lbody_open_ii_bool

\bool_new:N \g__ba_list_pending_iii_bool
\bool_new:N \g__ba_list_open_iii_bool
\bool_new:N \g__ba_li_open_iii_bool
\bool_new:N \g__ba_lbody_open_iii_bool

% Block structure state:
\bool_new:N \g__ba_block_open_bool
\bool_new:N \g__ba_in_block_title_bool
\bool_new:N \g__ba_block_title_open_bool

\cs_new_protected:Npn \ba_body_begin:
  {
    \bool_gset_true:N \g__ba_body_active_bool
  }

\cs_new_protected:Npn \ba_body_end:
  {
    \ba_paragraph_end:
    \bool_gset_false:N \g__ba_body_active_bool
  }

\cs_new_protected:Npn \ba_paragraph_begin:
  {
    \bool_if:NT \g__ba_frame_active_bool
      {
        \bool_if:NT \g__ba_body_active_bool
          {
            \bool_if:NF \g__ba_in_title_bool
              {
                \bool_if:NF \g__ba_in_label_bool
                  {
                    \bool_if:NF \g__ba_frame_unsupported_bool
                      {
                        \int_compare:nNnT { \g__ba_para_suppress_int } = { 0 }
                          {
                            \bool_if:NTF \g__ba_in_block_title_bool
                              {
                                \bool_if:NF \g__ba_block_title_open_bool
                                  {
                                    \tag_struct_begin:n { tag=blocktitle }
                                    \tag_mc_begin:n { }
                                    \bool_gset_true:N \g__ba_block_title_open_bool
                                  }
                              }
                              {
                                \bool_if:NF \g__ba_para_open_bool
                                  {
                                    \tag_struct_begin:n { tag=P }
                                    \tag_mc_begin:n { }
                                    \bool_gset_true:N \g__ba_para_open_bool
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \ba_paragraph_end:
  {
    \bool_if:NT \g__ba_block_title_open_bool
      {
        \tag_mc_end:
        \tag_struct_end:
        \bool_gset_false:N \g__ba_block_title_open_bool
      }
    \bool_if:NT \g__ba_para_open_bool
      {
        \tag_mc_end:
        \tag_struct_end:
        \bool_gset_false:N \g__ba_para_open_bool
      }
  }

\cs_new_protected:Npn \ba_block_begin:
  {
    \ba_paragraph_end:
    \bool_if:NT \g__ba_frame_active_bool
      {
        \bool_if:NF \g__ba_frame_unsupported_bool
          {
            \tag_struct_begin:n { tag=block }
            \bool_gset_true:N \g__ba_block_open_bool
            \bool_gset_true:N \g__ba_in_block_title_bool
          }
      }
  }

\cs_new_protected:Npn \ba_block_body_begin:
  {
    \ba_paragraph_end:
    \bool_gset_false:N \g__ba_in_block_title_bool
  }

\cs_new_protected:Npn \ba_block_end:
  {
    \ba_paragraph_end:
    \int_compare:nNnT { \g__ba_list_depth_int } > { 0 }
      {
        \ba_list_close_all:
      }
    \bool_if:NT \g__ba_block_open_bool
      {
        \tag_struct_end:
        \bool_gset_false:N \g__ba_block_open_bool
      }
    \bool_gset_false:N \g__ba_in_block_title_bool
  }

\cs_new_protected:Npn \ba_list_close_item_at:n #1
  {
    \ba_paragraph_end:
    \use:c { bool_if:cT } { g__ba_lbody_open_ \int_to_roman:n { #1 } _bool }
      {
        \tag_struct_end:
        \bool_gset_false:c { g__ba_lbody_open_ \int_to_roman:n { #1 } _bool }
      }
    \use:c { bool_if:cT } { g__ba_li_open_ \int_to_roman:n { #1 } _bool }
      {
        \tag_struct_end:
        \bool_gset_false:c { g__ba_li_open_ \int_to_roman:n { #1 } _bool }
      }
  }

\cs_new_protected:Npn \ba_list_close_at:n #1
  {
    \ba_list_close_item_at:n { #1 }
    \use:c { bool_if:cT } { g__ba_list_open_ \int_to_roman:n { #1 } _bool }
      {
        \tag_struct_end:
        \bool_gset_false:c { g__ba_list_open_ \int_to_roman:n { #1 } _bool }
      }
    \bool_gset_false:c { g__ba_list_pending_ \int_to_roman:n { #1 } _bool }
  }

\cs_new_protected:Npn \ba_list_close_all:
  {
    \ba_paragraph_end:
    \int_step_inline:nnnn { \g__ba_list_depth_int } { -1 } { 1 }
      {
        \ba_list_close_at:n { ##1 }
      }
    \int_gzero:N \g__ba_list_depth_int
  }

\cs_new_protected:Npn \ba_frame_begin:
  {
    \bool_if:NF \g__ba_frame_active_bool
      {
        \tag_struct_begin:n { tag=frame }
        \bool_gset_true:N \g__ba_frame_active_bool
        \bool_gset_false:N \g__ba_body_active_bool
        \bool_gset_false:N \g__ba_frame_unsupported_bool
        \int_step_inline:nn { 3 }
          {
            \bool_gset_false:c { g__ba_list_pending_ \int_to_roman:n { ##1 } _bool }
            \bool_gset_false:c { g__ba_list_open_ \int_to_roman:n { ##1 } _bool }
            \bool_gset_false:c { g__ba_li_open_ \int_to_roman:n { ##1 } _bool }
            \bool_gset_false:c { g__ba_lbody_open_ \int_to_roman:n { ##1 } _bool }
          }
        \int_gzero:N \g__ba_list_depth_int
        \int_gzero:N \g__ba_para_suppress_int
        \bool_gset_false:N \g__ba_block_open_bool
        \bool_gset_false:N \g__ba_in_block_title_bool
        \bool_gset_false:N \g__ba_block_title_open_bool
      }
  }

\cs_new_protected:Npn \ba_frame_end:
  {
    \ba_body_end:
    \ba_list_close_all:
    \bool_if:NT \g__ba_block_open_bool
      {
        \tag_struct_end:
        \bool_gset_false:N \g__ba_block_open_bool
      }
    \bool_if:NT \g__ba_frame_active_bool
      {
        \tag_struct_end:
        \bool_gset_false:N \g__ba_frame_active_bool
      }
  }

\cs_new_protected:Npn \ba_frametitle_begin:
  {
    \ba_body_end:
    \bool_if:NT \g__ba_frame_active_bool
      {
        \bool_gset_true:N \g__ba_in_title_bool
        \tag_struct_begin:n { tag=frametitle,firstkid=true }
        \tag_mc_begin:n { }
      }
  }

\cs_new_protected:Npn \ba_frametitle_end:
  {
    \bool_if:NT \g__ba_frame_active_bool
      {
        \tag_mc_end:
        \tag_struct_end:
        \bool_gset_false:N \g__ba_in_title_bool
      }
  }

\cs_new_protected:Npn \ba_suppress_begin:
  {
    \ba_list_close_all:
    \ba_paragraph_end:
    \bool_gset_true:N \g__ba_frame_unsupported_bool
    \int_gincr:N \g__ba_para_suppress_int
  }

\cs_new_protected:Npn \ba_suppress_end:
  {
    \int_compare:nNnT { \g__ba_para_suppress_int } > { 0 }
      { \int_gdecr:N \g__ba_para_suppress_int }
  }

\cs_new_protected:Npn \ba_list_begin:
  {
    \ba_paragraph_end:
    \bool_if:NT \g__ba_frame_active_bool
      {
        \bool_if:NF \g__ba_frame_unsupported_bool
          {
            \int_compare:nNnTF { \g__ba_para_suppress_int } = { 0 }
              {
                \int_compare:nNnTF { \g__ba_list_depth_int } < { 3 }
                  {
                    \int_gincr:N \g__ba_list_depth_int
                    \bool_gset_true:c { g__ba_list_pending_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
                  }
                  {
                    % List depth > 3 is unsupported.
                    \ba_suppress_begin:
                  }
              }
              {
                \int_gincr:N \g__ba_para_suppress_int
              }
          }
      }
  }

\cs_new_protected:Npn \ba_list_end:
  {
    \int_compare:nNnT { \g__ba_list_depth_int } > { 0 }
      {
        \ba_list_close_at:n { \g__ba_list_depth_int }
        \int_gdecr:N \g__ba_list_depth_int
      }
    \int_compare:nNnT { \g__ba_para_suppress_int } > { 0 }
      {
        \int_gdecr:N \g__ba_para_suppress_int
      }
  }

\cs_new_protected:Npn \ba_item_label_begin:
  {
    \ba_paragraph_end:
    \int_compare:nNnT { \g__ba_list_depth_int } > { 0 }
      {
        \use:c { bool_if:cT } { g__ba_list_pending_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
          {
            \tag_struct_begin:n { tag=L }
            \bool_gset_true:c { g__ba_list_open_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
            \bool_gset_false:c { g__ba_list_pending_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
          }
        \use:c { bool_if:cT } { g__ba_list_open_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
          {
            \ba_list_close_item_at:n { \g__ba_list_depth_int }
            \tag_struct_begin:n { tag=LI }
            \bool_gset_true:c { g__ba_li_open_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
            \tag_struct_begin:n { tag=Lbl }
            \bool_gset_true:N \g__ba_in_label_bool
            \tag_mc_begin:n { }
          }
      }
  }

\cs_new_protected:Npn \ba_item_label_end:
  {
    \int_compare:nNnT { \g__ba_list_depth_int } > { 0 }
      {
        \use:c { bool_if:cT } { g__ba_list_open_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
          {
            \bool_if:NT \g__ba_in_label_bool
              {
                \tag_mc_end:
                \tag_struct_end:
                \bool_gset_false:N \g__ba_in_label_bool
                \tag_struct_begin:n { tag=LBody }
                \bool_gset_true:c { g__ba_lbody_open_ \int_to_roman:n { \g__ba_list_depth_int } _bool }
              }
          }
      }
  }

% Retained as a low-level experimental API. The automatic hooks are idempotent
% with these commands, which keeps the validated manual prototypes usable.
\NewDocumentCommand \BeamerAccessibilityFrameBegin { } { \ba_frame_begin: }
\NewDocumentCommand \BeamerAccessibilityFrameEnd { } { \ba_frame_end: }
\NewDocumentCommand \BeamerAccessibilityParagraphBegin { } { \ba_paragraph_begin: }
\NewDocumentCommand \BeamerAccessibilityParagraphEnd { } { \ba_paragraph_end: }

\ExplSyntaxOff

% Ordinary prose is tagged only while a rendered Beamer slide body is active.
\AddToHook{para/begin}{\csname ba_paragraph_begin:\endcsname}
\AddToHook{para/end}{\csname ba_paragraph_end:\endcsname}

% List support for itemize and enumerate across nesting levels 1, 2, and 3:
\AddToHook{env/itemize/begin}{\csname ba_list_begin:\endcsname}
\AddToHook{env/itemize/end}{\csname ba_list_end:\endcsname}
\AddToHook{env/enumerate/begin}{\csname ba_list_begin:\endcsname}
\AddToHook{env/enumerate/end}{\csname ba_list_end:\endcsname}

% Wrap Beamer item and title templates after all preamble theme definitions.
\AddToHook{begindocument/end}{%
  \addtobeamertemplate{itemize item}
    {\csname ba_item_label_begin:\endcsname}
    {\csname ba_item_label_end:\endcsname}%
  \addtobeamertemplate{itemize subitem}
    {\csname ba_item_label_begin:\endcsname}
    {\csname ba_item_label_end:\endcsname}%
  \addtobeamertemplate{itemize subsubitem}
    {\csname ba_item_label_begin:\endcsname}
    {\csname ba_item_label_end:\endcsname}%
  \addtobeamertemplate{enumerate item}
    {\csname ba_item_label_begin:\endcsname}
    {\csname ba_item_label_end:\endcsname}%
  \addtobeamertemplate{enumerate subitem}
    {\csname ba_item_label_begin:\endcsname}
    {\csname ba_item_label_end:\endcsname}%
  \addtobeamertemplate{enumerate subsubitem}
    {\csname ba_item_label_begin:\endcsname}
    {\csname ba_item_label_end:\endcsname}%
  \addtobeamertemplate{frametitle}
    {\csname ba_frametitle_begin:\endcsname}
    {\csname ba_frametitle_end:\endcsname}%
  \addtobeamertemplate{block begin}
    {\csname ba_block_begin:\endcsname}
    {\csname ba_block_body_begin:\endcsname}%
  \addtobeamertemplate{block end}
    {}
    {\csname ba_block_end:\endcsname}%
  \addtobeamertemplate{block alerted begin}
    {\csname ba_block_begin:\endcsname}
    {\csname ba_block_body_begin:\endcsname}%
  \addtobeamertemplate{block alerted end}
    {}
    {\csname ba_block_end:\endcsname}%
  \addtobeamertemplate{block example begin}
    {\csname ba_block_begin:\endcsname}
    {\csname ba_block_body_begin:\endcsname}%
  \addtobeamertemplate{block example end}
    {}
    {\csname ba_block_end:\endcsname}%
}

% Precise frame body boundary: Beamer evaluates frame preamble setup before
% checkframetitle; the user-authored frame body begins immediately after.
\makeatletter
\let\ba@orig@beamer@checkframetitle\beamer@checkframetitle
\def\beamer@checkframetitle{\@ifnextchar\bgroup\ba@inlineframetitle{\csname ba_body_begin:\endcsname}}
\def\ba@inlineframetitle#1{%
  \@ifnextchar\bgroup{\frametitle{#1}\framesubtitle\csname ba_body_begin:\endcsname}{\frametitle{#1}\relax\csname ba_body_begin:\endcsname}%
}

% Safe overlay detection: when an item specifies overlay actions (e.g. \item<2->),
% Beamer calls \beamer@parseitem. For v0.5, overlay lists are marked unsupported
% to avoid generating misleading partial structure.
\let\ba@orig@beamer@parseitem\beamer@parseitem
\def\beamer@parseitem<#1>{%
  \csname ba_suppress_begin:\endcsname%
  \ba@orig@beamer@parseitem<#1>%
}
\makeatother

% Description lists remain unsupported in v0.5 and fall back cleanly.
\AddToHook{env/description/begin}{\csname ba_suppress_begin:\endcsname}
\AddToHook{env/description/end}{\csname ba_suppress_end:\endcsname}

% beamer@frameslide surrounds one rendered slide. The /after hook closes the
% structure only after Beamer has constructed the title and output boxes.
\AddToHook{env/beamer@frameslide/begin}{\csname ba_frame_begin:\endcsname}
\AddToHook{env/beamer@frameslide/after}{\csname ba_frame_end:\endcsname}




