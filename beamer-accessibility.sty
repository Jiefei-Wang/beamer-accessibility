% Footnote support: wrap footnote text handlers to maintain stream MC balance.
\let\ba@orig@framefootnotetext\beamer@framefootnotetext
\renewcommand<>\beamer@framefootnotetext[1]{%
  \csname ba_paragraph_end:\endcsname
  \global\setbox\beamer@footins\vbox{%
    \hsize\framewidth
    \textwidth\hsize
    \columnwidth\hsize
    \unvbox\beamer@footins
    \reset@font\footnotesize
    \@parboxrestore
    \protected@edef\@currentlabel
         {\csname p@footnote\endcsname\@thefnmark}%
    \color@begingroup
      \uncover#2{\@makefntext{%
        \rule\z@\footnotesep\ignorespaces#1\@finalstrut\strutbox}}%
    \color@endgroup
    \csname ba_paragraph_end:\endcsname}%
}
\let\@footnotetext=\beamer@framefootnotetext
\let\ba@orig@mpfootnotetext\@mpfootnotetext
\renewcommand<>\@mpfootnotetext[1]{%
  \csname ba_paragraph_end:\endcsname
  \global\setbox\@mpfootins\vbox{%
    \unvbox\@mpfootins
    \reset@font\footnotesize
    \hsize\columnwidth
    \@parboxrestore
    \protected@edef\@currentlabel
         {\csname p@mpfootnote\endcsname\@thefnmark}%
    \color@begingroup
      \uncover#2{\@makefntext{%
        \rule\z@\footnotesep\ignorespaces#1\@finalstrut\strutbox}}%
    \color@endgroup
    \csname ba_paragraph_end:\endcsname}%
}

